{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Herm",
  "description": "Documentation for Herm, the keyboard-driven terminal UI for Hermes Agent.",
  "colors": {
    "primary": "#7A4D22",
    "light": "#FFC799",
    "dark": "#B67845"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/liftaris/herm"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "introduction",
          "quickstart",
          "configuration"
        ]
      },
      {
        "group": "Core Features",
        "icon": "terminal",
        "expanded": true,
        "pages": [
          "features/chat",
          "features/sessions",
          "features/automation",
          "features/config"
        ]
      },
      {
        "group": "Eikon Avatars",
        "icon": "image",
        "expanded": true,
        "pages": [
          "eikon/overview",
          "eikon/gallery",
          "eikon/studio",
          "eikon/marketplace"
        ]
      },
      {
        "group": "Customization",
        "icon": "palette",
        "expanded": true,
        "pages": [
          "customization/themes",
          "customization/keybindings",
          "customization/slash-commands"
        ]
      },
      {
        "group": "Plugins",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "plugins/overview",
          "plugins/api-reference",
          "plugins/examples"
        ]
      },
      {
        "group": "Troubleshooting",
        "icon": "life-buoy",
        "expanded": true,
        "pages": [
          "troubleshooting/faq",
          "troubleshooting/common-issues"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Hermes Agent",
        "href": "https://hermes-agent.nousresearch.com/docs"
      },
      {
        "label": "Eikon gallery",
        "href": "https://eikon.liftaris.dev"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/liftaris/herm"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/liftaris/herm"
    }
  },
  "seo": {
    "indexing": "all"
  }
}
